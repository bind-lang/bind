package app.customers

distinct type CustomerId = UUID

entity Customer(
    val id: CustomerId,
    val name: String,
    val email: Email,
    val balance: Money
)

environment development {
    public val applicationName: String = env("APP_NAME", default = "Commerce")
    runtime secret val databaseUrl: DatabaseUrl = env("DATABASE_URL")
}

server fun getCustomer(id: CustomerId): Customer
    effects [db.read] {
    return db.customers.require(id)
}

fun normalizar(nome: String) = when (nome) {
    "" -> "sem nome"
    outro -> outro
}

server fun cadastrar(nome: String, email: Email, saldo: Money): Customer
    effects [db.read, db.write] {
    val novo = db.customers.insert {
        name = normalizar(nome)
        email = email
        balance = saldo
    }
    return db.customers.require(novo.id)
}

client component CustomerPage(id: CustomerId) {
    val customer = server.getCustomer(id)

    UI {
        Text(customer.name)
        Text(customer.email)
    }
}
