package app.stock

distinct type Count = Int
distinct type Counts = List<Int>
distinct type MaybeCount = Int?

entity Item(
    val id: UUID,
    val name: String,
    val quantity: Int,
    val reserved: Int?,
    val stock: Count
)

data class Summary(
    val history: List<Int>,
    val series: Counts,
    val spare: MaybeCount
)

server fun reservar(id: UUID, quantidade: Int): Item
    effects [db.read] {
    return db.items.require(id)
}

client component ItemPage(id: UUID, quantidade: Int) {
    val item = server.reservar(id, quantidade)

    UI {
        Text(item.name)
        Text(item.quantity)
        Text(item.stock)
    }
}
