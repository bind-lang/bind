// Int arithmetic in the JS backend: big literals, checked division with `?:`, Double, Float.
fun grande(x: Int) = x * 123456789012345678901234567890 + 1

fun divide(a: Int, b: Int): Int = (a / b) ?: (a % b) ?: -7

fun compara(a: Int, b: Int): Boolean = a < b && !(a == b) || a >= -b

fun duplo(x: Double): Double = x * 0.1 + 1e21

fun simples(x: Float): Float = x * 0.1f + 1.0f

fun texto(a: String, b: String): Boolean = a + b < b

client component Contas(a: Int, b: Int) {
    UI {
        Text(divide(a, b))
        Text(grande(a))
        Text(duplo(0.5))
        Text(simples(0.25f))
        Text(compara(a, b))
        Text(texto("b", "a"))
    }
}
