}

fn db_insert_customers(ctx: crate::bind_runtime::Ctx, p0_name: ::std::string::String, p1_email: ::std::string::String, p2_balance: ::rust_decimal::Decimal, p3_visits: crate::bind_runtime::Int) -> crate::bind_runtime::BoxFuture<crate::app::Customer> {
    ::std::boxed::Box::pin(async move {
        let query = ::sqlx::query("INSERT INTO \"customers\" (\"name\", \"email\", \"balance\", \"visits\") VALUES ($1::text, $2::text, $3::numeric, $4::numeric) RETURNING \"id\"::uuid AS \"id\", \"name\"::text AS \"name\", \"email\"::text AS \"email\", \"balance\"::numeric AS \"balance\", \"visits\"::numeric AS \"visits\", \"nickname\"::text AS \"nickname\"").bind(p0_name).bind(p1_email).bind(p2_balance).bind(p3_visits);
        let row = {
            let mut transaction = ctx.transaction().await?;
            query.fetch_one(&mut **transaction).await?
