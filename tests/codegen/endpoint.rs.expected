fn decode_customers(row: &::sqlx::postgres::PgRow) -> ::std::result::Result<crate::app::Customer, crate::bind_runtime::AppError> {
    ::std::result::Result::Ok(crate::app::Customer {
        id: crate::app::CustomerId { value: ::sqlx::Row::try_get::<::uuid::Uuid, _>(row, "id")? },
        name: ::sqlx::Row::try_get::<::std::string::String, _>(row, "name")?,
