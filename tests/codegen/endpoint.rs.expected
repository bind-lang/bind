fn db_require_customers(ctx: crate::bind_runtime::Ctx, p0_id: crate::app::CustomerId) -> crate::bind_runtime::BoxFuture<crate::app::Customer> {
    ::std::boxed::Box::pin(async move {
        let query = ::sqlx::query("SELECT \"id\"::uuid AS \"id\", \"name\"::text AS \"name\", \"email\"::text AS \"email\", \"balance\"::numeric AS \"balance\", \"visits\"::numeric AS \"visits\", \"nickname\"::text AS \"nickname\" FROM \"customers\" WHERE \"id\" = $1::uuid LIMIT 1").bind(p0_id.value);
        let row = {
            let mut transaction = ctx.transaction().await?;
            query.fetch_optional(&mut **transaction).await?
        };
        match row {
            ::std::option::Option::Some(row) => decode_customers(&row),
            ::std::option::Option::None => ::std::result::Result::Err(crate::bind_runtime::AppError::NotFound(::std::string::String::from("Customer not found"))),
        }
    })
