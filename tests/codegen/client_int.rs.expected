fn db_require_items(ctx: crate::bind_runtime::Ctx, p0_id: ::uuid::Uuid) -> crate::bind_runtime::BoxFuture<Item> {
    ::std::boxed::Box::pin(async move {
        let query = ::sqlx::query("SELECT \"id\"::uuid AS \"id\", \"name\"::text AS \"name\", \"quantity\"::numeric AS \"quantity\", \"reserved\"::numeric AS \"reserved\", \"stock\"::numeric AS \"stock\" FROM \"items\" WHERE \"id\" = $1::uuid LIMIT 1").bind(p0_id);
        let row = {
            let mut transaction = ctx.transaction().await?;
            query.fetch_optional(&mut **transaction).await?
