        match row {
            ::std::option::Option::Some(row) => decode_items(&row),
            ::std::option::Option::None => ::std::result::Result::Err(crate::bind_runtime::AppError::NotFound(::std::string::String::from("Item not found"))),
        }
    })
}

fn decode_items(row: &::sqlx::postgres::PgRow) -> ::std::result::Result<Item, crate::bind_runtime::AppError> {
    ::std::result::Result::Ok(Item {
        id: ::sqlx::Row::try_get::<::uuid::Uuid, _>(row, "id")?,
        name: ::sqlx::Row::try_get::<::std::string::String, _>(row, "name")?,
        quantity: ::sqlx::Row::try_get::<crate::bind_runtime::Int, _>(row, "quantity")?,
        reserved: ::sqlx::Row::try_get::<::std::option::Option<crate::bind_runtime::Int>, _>(row, "reserved")?,
        stock: Count(::sqlx::Row::try_get::<crate::bind_runtime::Int, _>(row, "stock")?),
    })
}

