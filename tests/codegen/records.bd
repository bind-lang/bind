distinct type Codigo = String

sealed class Lista<T> {
    data class Cons(val cabeca: T, val cauda: Lista<T>)
    data object Vazia
}

data class Config(val type: String, val match: Int, val filho: Config?)

fun codigo(s: String) = Codigo(s)

fun cabeca(l: Lista<Int>): Int = when (l) {
    Cons(h, _) -> h
    Vazia -> -1
}

fun segundo(l: Lista<Int>): Int = when (l) {
    Cons(_, Cons(x, _)) -> x
    _ -> 0
}

fun um(l: Lista<String>) = Cons("a", l)

fun tipo(c: Config) = c.type

fun neto(c: Config): Int? = c.filho?.match

fun folha(c: Config): Int = when (c) {
    Config(_, m, null) -> m
    Config(_, _, f) -> 0
}

sealed class Unico {
    data class So(val n: Int?)
}

fun unico(u: Unico): Int = when (u) {
    So(null) -> 0
    So(x) -> 1
}

fun unicoInterno(u: Unico?): Int = when (u) {
    So(1) -> 1
    _ -> 0
}

sealed class Arv {
    data class Nodo(val v: Int, val filhos: List<Arv>)
}

fun total(a: Arv): Int = when (a) {
    Nodo(v, fs) -> fold(fs, v, { s, f -> s + total(f) })
}

sealed class Opt<T> {
    data object Nada
}

data class Marca<T>(val nome: String)

fun nada(): Opt<Int> = Nada

fun ehNada(o: Opt<Int>): Boolean = when (o) {
    Nada -> true
}

fun marca(): Marca<Int> = Marca("x")

fun nomeMarca(m: Marca<Int>): String = when (m) {
    Marca(n) -> n
}

sealed class Rotulo {
    data object Foo_bar
    data object HTTPError
}

fun rotulo(): Rotulo = HTTPError

// Struct and variant literals in an `if` condition need parentheses in Rust.
fun literalNaCondicao(m: Int): String = if (Config("t", m, null).match > 0) "sim" else "nao"

fun varianteNaCondicao(m: Int): String = if (Cons(1, Vazia) == Cons(m, Vazia)) "sim" else "nao"
