module Main exposing (main)

import Browser
import Html exposing (Html, button, div, form, h1, input, label, main_, p, text)
import Html.Attributes exposing (class, placeholder, type_, value)
import Html.Events exposing (onInput, onSubmit)
import Http
import Json.Decode as D exposing (Decoder)
import Json.Encode as E

type Count
    = Count Int

type Counts
    = Counts (List Int)

type MaybeCount
    = MaybeCount (Maybe Int)

type alias Item =
    { id : String
    , name : String
    , quantity : Int
    , reserved : Maybe Int
    , stock : Count
    }

type alias Summary =
    { history : List Int
    , series : Counts
    , spare : MaybeCount
    }

andMap : Decoder a -> Decoder (a -> b) -> Decoder b
andMap valueDecoder functionDecoder =
    D.map2 (|>) valueDecoder functionDecoder

intDecoder : D.Decoder Int
intDecoder =
    D.string
        |> D.andThen
            (\text_ ->
                let
                    negative_ =
                        String.startsWith "-" text_

                    digits_ =
                        if negative_ then
                            String.dropLeft 1 text_

                        else
                            text_

                    length_ =
                        String.length digits_

                    canonical_ =
                        length_
                            > 0
                            && String.all Char.isDigit digits_
                            && (digits_ == "0" || not (String.startsWith "0" digits_))
                            && not (negative_ && digits_ == "0")

                    inRange_ =
                        length_ < 16 || (length_ == 16 && digits_ <= "9007199254740991")
                in
                if not canonical_ then
                    D.fail ("Expected an integer string, got \"" ++ text_ ++ "\"")

                else if not inRange_ then
                    D.fail ("Integer out of range (|n| <= 9007199254740991): " ++ text_)

                else
                    -- `String.toInt` accumulates in floating point and rounds near 2^53, so
                    -- the digits are converted in two exact halves.
                    case
                        ( if length_ <= 8 then
                            Just 0

                          else
                            String.toInt (String.dropRight 8 digits_)
                        , String.toInt (String.right 8 digits_)
                        )
                    of
                        ( Just high_, Just low_ ) ->
                            let
                                magnitude_ =
                                    high_ * 100000000 + low_
                            in
                            D.succeed
                                (if negative_ then
                                    negate magnitude_

                                 else
                                    magnitude_
                                )

                        _ ->
                            D.fail ("Expected an integer string, got \"" ++ text_ ++ "\"")
            )

encodeInt : Int -> E.Value
encodeInt value_ =
    E.string (String.fromInt value_)

decodeCount : Decoder Count
decodeCount =
    D.map Count intDecoder

encodeCount : Count -> E.Value
encodeCount (Count value_) =
    encodeInt value_

decodeCounts : Decoder Counts
decodeCounts =
    D.map Counts (D.list intDecoder)

encodeCounts : Counts -> E.Value
encodeCounts (Counts value_) =
    E.list (\item_ -> encodeInt item_) value_

decodeMaybeCount : Decoder MaybeCount
decodeMaybeCount =
    D.map MaybeCount (D.nullable intDecoder)

encodeMaybeCount : MaybeCount -> E.Value
encodeMaybeCount (MaybeCount value_) =
    Maybe.withDefault E.null (Maybe.map (\item_ -> encodeInt item_) value_)

decodeItem : Decoder Item
decodeItem =
    D.succeed Item
        |> andMap (D.field "id" D.string)
        |> andMap (D.field "name" D.string)
        |> andMap (D.field "quantity" intDecoder)
        |> andMap (D.field "reserved" (D.nullable intDecoder))
        |> andMap (D.field "stock" decodeCount)

encodeItem : Item -> E.Value
encodeItem value_ =
    E.object
        [ ( "id", E.string value_.id )
        , ( "name", E.string value_.name )
        , ( "quantity", encodeInt value_.quantity )
        , ( "reserved", Maybe.withDefault E.null (Maybe.map (\item_ -> encodeInt item_) value_.reserved) )
        , ( "stock", encodeCount value_.stock )
        ]

decodeSummary : Decoder Summary
decodeSummary =
    D.succeed Summary
        |> andMap (D.field "history" (D.list intDecoder))
        |> andMap (D.field "series" decodeCounts)
        |> andMap (D.field "spare" decodeMaybeCount)

encodeSummary : Summary -> E.Value
encodeSummary value_ =
    E.object
        [ ( "history", E.list (\item_ -> encodeInt item_) value_.history )
        , ( "series", encodeCounts value_.series )
        , ( "spare", encodeMaybeCount value_.spare )
        ]

type RemoteData a
    = Idle
    | Loading
    | Loaded a
    | Failed String

type alias Model =
    { state : RemoteData Item
    , inputId : String
    , inputQuantidade : String
    }

type Msg
    = Submit
    | SetId String
    | SetQuantidade String
    | GotResponse (Result Http.Error Item)

main : Program () Model Msg
main =
    Browser.element
        { init = \_ -> ( initialModel, Cmd.none )
        , update = update
        , subscriptions = \_ -> Sub.none
        , view = view
        }

initialModel : Model
initialModel =
    { state = Idle
    , inputId = ""
    , inputQuantidade = ""
    }

update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of
        SetId next ->
            ( { model | inputId = next }, Cmd.none )

        SetQuantidade next ->
            ( { model | inputQuantidade = next }, Cmd.none )

        Submit ->
            ( { model | state = Loading }
            , Http.post
                { url = "/api/reservar"
                , body = Http.jsonBody (E.object
                    [ ( "id", E.string model.inputId )
                    , ( "quantidade", E.string (String.trim model.inputQuantidade) )
                    ]
                  )
                , expect = Http.expectJson GotResponse decodeItem
                }
            )

        GotResponse result ->
            case result of
                Ok response ->
                    ( { model | state = Loaded response }, Cmd.none )

                Err error ->
                    ( { model | state = Failed (httpError error) }, Cmd.none )

view : Model -> Html Msg
view model =
    main_ [ class "shell" ]
        [ div [ class "panel" ]
            [ p [ class "eyebrow" ] [ text "BIND CERTIFIED APPLICATION" ]
            , h1 [] [ text "ItemPage" ]
            , form [ onSubmit Submit ]
                [ label [] [ text "Id", input [ type_ "text", placeholder "UUID", value model.inputId, onInput SetId ] [] ]
                , label [] [ text "Quantidade", input [ type_ "text", placeholder "Int", value model.inputQuantidade, onInput SetQuantidade ] [] ]
                , button [ type_ "submit" ] [ text "Execute verified call" ]
                ]
            , viewState model.state
            ]
        ]

viewState : RemoteData Item -> Html Msg
viewState state =
    case state of
        Idle ->
            p [ class "muted" ] [ text "Ready." ]

        Loading ->
            p [ class "muted" ] [ text "Loading…" ]

        Failed message ->
            p [ class "error" ] [ text message ]

        Loaded value ->
            div [ class "result" ]
                [ p [] [ text value.name ]
                , p [] [ text (String.fromInt value.quantity) ]
                , p [] [ text ((case value.stock of
                    Count inner_ ->
                        String.fromInt inner_
                )) ]
                ]

httpError : Http.Error -> String
httpError error =
    case error of
        Http.BadUrl _ ->
            "Invalid server URL"

        Http.Timeout ->
            "The server timed out"

        Http.NetworkError ->
            "The server is unreachable"

        Http.BadStatus status ->
            "Server returned HTTP " ++ String.fromInt status

        Http.BadBody message ->
            "Contract decoding failed: " ++ message
