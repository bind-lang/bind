/// Response of one RPC call: HTTP status and JSON body.
#[derive(Debug)]
pub struct HttpResult {
    pub status: u16,
    pub body: ::std::string::String,
}

/// `{"error": message}` with the error's status; the message never exposes internals (an
/// internal error is logged on standard error instead).
fn error_result(error: &crate::bind_runtime::AppError) -> HttpResult {
    crate::bind_runtime::log_error(error);
    let body = ::serde_json::json!({ "error": error.public_message() }).to_string();
    HttpResult { status: error.status(), body }
}

/// Ends the call's transaction: serializes the value, then commits; any error (including
/// the commit's) rolls back and becomes the response. A call never reports success
/// without a committed transaction.
async fn finish<T: ::serde::Serialize>(
    ctx: crate::bind_runtime::Ctx,
    result: ::std::result::Result<T, crate::bind_runtime::AppError>,
) -> HttpResult {
    let transaction = match ctx.take_transaction().await {
        ::std::result::Result::Ok(transaction) => transaction,
        ::std::result::Result::Err(error) => return error_result(&error),
    };
    ::std::mem::drop(ctx);
    let body = result.and_then(|value| ::serde_json::to_string(&value).map_err(crate::bind_runtime::AppError::from));
    match body {
        ::std::result::Result::Ok(body) => match transaction.commit().await {
            ::std::result::Result::Ok(()) => HttpResult { status: 200, body },
            ::std::result::Result::Err(error) => error_result(&crate::bind_runtime::AppError::from(error)),
        },
        ::std::result::Result::Err(error) => {
            // The error is the response; a failed rollback leaves nothing committed either.
            let _ = transaction.rollback().await;
            error_result(&error)
        }
    }
}

/// Decodes the request (strict UTF-8, no byte order mark, then JSON), opens the transaction
/// (with its statement timeout: the runtime's `begin_transaction`) and builds the call's context.
async fn begin<I: ::serde::de::DeserializeOwned>(
    body: &[u8],
    pool: &::sqlx::PgPool,
) -> ::std::result::Result<(I, crate::bind_runtime::Ctx), HttpResult> {
    let text = crate::bind_runtime::request_text(body).map_err(|error| error_result(&error))?;
    let input = ::serde_json::from_str(text)
    .map_err(|error| error_result(&crate::bind_runtime::AppError::BadRequest(error.to_string())))?;
    let transaction = crate::bind_runtime::begin_transaction(pool, false)
    .await
    .map_err(|error| error_result(&error))?;
    ::std::result::Result::Ok((input, crate::bind_runtime::Ctx::with_transaction(transaction)))
}

/// Runs the RPC procedure at `path` with the JSON `body`, in one transaction. The path's
/// percent-escapes are decoded first (a browser sends `/api/café` as `/api/caf%C3%A9`).
pub async fn handle_rpc(path: &str, body: &[u8], pool: &::sqlx::PgPool) -> HttpResult {
    let ::std::option::Option::Some(path) = crate::bind_runtime::decode_path(path) else {
        return error_result(&crate::bind_runtime::AppError::BadRequest(::std::string::String::from("malformed request path")));
    };
    match crate::bind_runtime::rpc_route(&path) {
        "/api/ping" => {
            let (input, ctx) = match begin::<PingInput>(body, pool).await {
                ::std::result::Result::Ok(started) => started,
                ::std::result::Result::Err(response) => return response,
            };
            let result = app::bind_ping(ctx.clone()).await;
            finish(ctx, result).await
        }
        _ => error_result(&crate::bind_runtime::AppError::NotFound(::std::string::String::from("RPC procedure not found"))),
    }
}

/// `handle_rpc` on a runtime worker thread, whose stack is sized for deep Bind recursion
/// (the thread that drives the HTTP runtime may have a smaller one).
pub async fn serve_rpc(
    path: ::std::string::String,
    body: ::std::vec::Vec<u8>,
    pool: ::sqlx::PgPool,
) -> HttpResult {
    match ::tokio::spawn(async move { handle_rpc(&path, &body, &pool).await }).await {
        ::std::result::Result::Ok(result) => result,
        ::std::result::Result::Err(_) => error_result(&crate::bind_runtime::AppError::Internal(::std::string::String::from("the request task failed"))),
    }
}

/// Content type of the page responses (`handle_page`).
pub const PAGE_CONTENT_TYPE: &str = "text/html; charset=utf-8";

/// Content type of the RPC responses (`handle_rpc`).
pub const RPC_CONTENT_TYPE: &str = "application/json; charset=utf-8";

/// Metadata of the page shell (`[web]` in `bind.toml`).
const PAGE_META: crate::bind_runtime::PageMeta<'static> = crate::bind_runtime::PageMeta {
    title: "Bind & SSR",
    description: ::std::option::Option::Some("Páginas \"renderizadas\" no servidor"),
    language: "pt-BR",
    stylesheet: "/styles.css",
};

/// The error page of `error`, with its status; the message never exposes internals (an
/// internal error is logged on standard error instead).
fn page_error(error: &crate::bind_runtime::AppError) -> HttpResult {
    crate::bind_runtime::log_error(error);
    let (status, body) = crate::bind_runtime::error_page(error, &PAGE_META);
    HttpResult { status, body }
}

/// The page of a rendered component.
fn page_result(node: &crate::bind_runtime::Node) -> HttpResult {
    let body = crate::bind_runtime::page_html(&PAGE_META, &crate::bind_runtime::render_html(node));
    HttpResult { status: 200, body }
}

/// `GET /`: the page of component `Ficha` (HTML, `PAGE_CONTENT_TYPE`). Its parameters come
/// from the query string `query` (absent, repeated or invalid: a 400 page naming the
/// parameter); server calls run in one read-only transaction, always rolled
/// back (the page is read-only: `GET` and `HEAD` never commit); an error's page has the
/// error's status.
pub async fn handle_page(query: &str, pool: &::sqlx::PgPool) -> HttpResult {
    let params = crate::bind_runtime::QueryParams::parse(query);
    let a0 = match crate::bind_runtime::param::<::std::string::String>(&params, "nome") {
        ::std::result::Result::Ok(value) => value,
        ::std::result::Result::Err(error) => return page_error(&error),
    };
    let a1 = match crate::bind_runtime::param::<::std::string::String>(&params, "codigo") {
        ::std::result::Result::Ok(value) => crate::app::Codigo { value: crate::app::Nome { value: value } },
        ::std::result::Result::Err(error) => return page_error(&error),
    };
    let a2 = match crate::bind_runtime::param::<::std::string::String>(&params, "email") {
        ::std::result::Result::Ok(value) => value,
        ::std::result::Result::Err(error) => return page_error(&error),
    };
    let a3 = match crate::bind_runtime::param::<::std::string::String>(&params, "site") {
        ::std::result::Result::Ok(value) => value,
        ::std::result::Result::Err(error) => return page_error(&error),
    };
    let a4 = match crate::bind_runtime::param::<crate::bind_runtime::Int>(&params, "n") {
        ::std::result::Result::Ok(value) => value,
        ::std::result::Result::Err(error) => return page_error(&error),
    };
    let a5 = match crate::bind_runtime::param::<::uuid::Uuid>(&params, "id") {
        ::std::result::Result::Ok(value) => value,
        ::std::result::Result::Err(error) => return page_error(&error),
    };
    let a6 = match crate::bind_runtime::param::<::chrono::NaiveDate>(&params, "dia") {
        ::std::result::Result::Ok(value) => value,
        ::std::result::Result::Err(error) => return page_error(&error),
    };
    let a7 = match crate::bind_runtime::param::<::chrono::NaiveDateTime>(&params, "hora") {
        ::std::result::Result::Ok(value) => value,
        ::std::result::Result::Err(error) => return page_error(&error),
    };
    let a8 = match crate::bind_runtime::param::<::chrono::DateTime<::chrono::Utc>>(&params, "quando") {
        ::std::result::Result::Ok(value) => value,
        ::std::result::Result::Err(error) => return page_error(&error),
    };
    // The component makes no server call: no transaction.
    match app::bind_Ficha(crate::bind_runtime::Ctx::pure(), a0, a1, a2, a3, a4, a5, a6, a7, a8).await {
        ::std::result::Result::Ok(node) => page_result(&node),
        ::std::result::Result::Err(error) => page_error(&error),
    }
}

/// `handle_page` on a runtime worker thread (see `serve_rpc`).
pub async fn serve_page(query: ::std::string::String, pool: ::sqlx::PgPool) -> HttpResult {
    match ::tokio::spawn(async move { handle_page(&query, &pool).await }).await {
        ::std::result::Result::Ok(result) => result,
        ::std::result::Result::Err(_) => page_error(&crate::bind_runtime::AppError::Internal(::std::string::String::from("the request task failed"))),
    }
}

/// An HTTP response: status, content type and body.
#[derive(Debug)]
pub struct HttpResponse {
    pub status: u16,
    pub content_type: &'static str,
    pub body: ::std::string::String,
}

/// Routes one request: `GET /` is the page (`query` is its query string, with or without the
/// leading `?`), every other request an RPC call (`serve_rpc`).
pub async fn serve(
    method: &str,
    path: ::std::string::String,
    query: ::std::string::String,
    body: ::std::vec::Vec<u8>,
    pool: ::sqlx::PgPool,
) -> HttpResponse {
    if method == "GET" && (path.is_empty() || path == "/") {
        let result = serve_page(query, pool).await;
        HttpResponse { status: result.status, content_type: PAGE_CONTENT_TYPE, body: result.body }
    } else {
        let result = serve_rpc(path, body, pool).await;
        HttpResponse { status: result.status, content_type: RPC_CONTENT_TYPE, body: result.body }
    }
}

#[cfg(test)]
mod tests {
    #[test]
    fn requests_with_unknown_fields_are_rejected() {
        assert!(::serde_json::from_str::<super::PingInput>("{\"bindUnknownField\":0}").is_err());
    }

    #[test]
    fn unknown_procedures_and_malformed_requests_never_reach_the_database()
    -> ::std::result::Result<(), ::std::boxed::Box<dyn ::std::error::Error>> {
        let runtime = ::tokio::runtime::Builder::new_current_thread().enable_all().build()?;
        runtime.block_on(async {
            let pool = ::sqlx::postgres::PgPoolOptions::new()
            .connect_lazy("postgresql://bind-test.invalid/none")?;
            let missing = super::handle_rpc("/api/bindMissingProcedure", b"{}", &pool).await;
            assert_eq!(missing.status, 404);
            let malformed = super::handle_rpc("/api/ping", b"not json", &pool).await;
            assert_eq!(malformed.status, 400);
            ::std::result::Result::Ok(())
        })
    }

    #[test]
    fn pages_with_a_missing_parameter_are_400() -> ::std::result::Result<(), ::std::boxed::Box<dyn ::std::error::Error>> {
        let runtime = ::tokio::runtime::Builder::new_current_thread().enable_all().build()?;
        runtime.block_on(async {
            let pool = ::sqlx::postgres::PgPoolOptions::new()
            .connect_lazy("postgresql://bind-test.invalid/none")?;
            let page = super::handle_page("", &pool).await;
            assert_eq!(page.status, 400);
            assert!(page.body.contains(&crate::bind_runtime::bad_parameter_message("nome")));
            ::std::result::Result::Ok(())
        })
    }
}
