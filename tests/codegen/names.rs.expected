fn db_find_things(ctx: crate::bind_runtime::Ctx, p0_id: crate::app::ThingId) -> crate::bind_runtime::BoxFuture<::std::option::Option<crate::app::Thing>> {
    ::std::boxed::Box::pin(async move {
        let query = ::sqlx::query("SELECT \"id\"::uuid AS \"id\", \"label\"::text AS \"label\" FROM \"things\" WHERE \"id\" = $1::uuid LIMIT 1").bind(p0_id.value);
        let row = {
            let mut transaction = ctx.transaction().await?;
            query.fetch_optional(&mut **transaction).await?
        };
        row.as_ref().map(decode_things).transpose()
    })
}

fn decode_things(row: &::sqlx::postgres::PgRow) -> ::std::result::Result<crate::app::Thing, crate::bind_runtime::AppError> {
