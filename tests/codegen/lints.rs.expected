/// Response of one RPC call: HTTP status and JSON body.
#[derive(Debug)]
pub struct HttpResult {
    pub status: u16,
    pub body: ::std::string::String,
}

/// `{"error": message}` with the error's status; the message never exposes internals (an
/// internal error is logged on standard error instead).
fn error_result(error: &crate::bind_runtime::AppError) -> HttpResult {
    crate::bind_runtime::log_error(error);
    let body = ::serde_json::json!({ "error": error.public_message() }).to_string();
    HttpResult { status: error.status(), body }
}

/// Ends the call's transaction: serializes the value, then commits; any error (including
/// the commit's) rolls back and becomes the response. A call never reports success
/// without a committed transaction.
async fn finish<T: ::serde::Serialize>(
    ctx: crate::bind_runtime::Ctx,
    result: ::std::result::Result<T, crate::bind_runtime::AppError>,
) -> HttpResult {
    let transaction = match ctx.take_transaction().await {
        ::std::result::Result::Ok(transaction) => transaction,
        ::std::result::Result::Err(error) => return error_result(&error),
    };
    ::std::mem::drop(ctx);
    let body = result.and_then(|value| ::serde_json::to_string(&value).map_err(crate::bind_runtime::AppError::from));
    match body {
        ::std::result::Result::Ok(body) => match transaction.commit().await {
            ::std::result::Result::Ok(()) => HttpResult { status: 200, body },
            ::std::result::Result::Err(error) => error_result(&crate::bind_runtime::AppError::from(error)),
        },
        ::std::result::Result::Err(error) => {
            // The error is the response; a failed rollback leaves nothing committed either.
            let _ = transaction.rollback().await;
            error_result(&error)
        }
    }
}

/// Decodes the request (strict UTF-8, no byte order mark, then JSON), opens the transaction
/// and builds the call's context.
async fn begin<I: ::serde::de::DeserializeOwned>(
    body: &[u8],
    pool: &::sqlx::PgPool,
) -> ::std::result::Result<(I, crate::bind_runtime::Ctx), HttpResult> {
    let text = crate::bind_runtime::request_text(body).map_err(|error| error_result(&error))?;
    let input = ::serde_json::from_str(text)
    .map_err(|error| error_result(&crate::bind_runtime::AppError::BadRequest(error.to_string())))?;
    let transaction = pool
    .begin()
    .await
    .map_err(|error| error_result(&crate::bind_runtime::AppError::from(error)))?;
    ::std::result::Result::Ok((input, crate::bind_runtime::Ctx::with_transaction(transaction)))
}

/// Runs the RPC procedure at `path` with the JSON `body`, in one transaction. The path's
/// percent-escapes are decoded first (a browser sends `/api/café` as `/api/caf%C3%A9`).
pub async fn handle_rpc(path: &str, body: &[u8], pool: &::sqlx::PgPool) -> HttpResult {
    let ::std::option::Option::Some(path) = crate::bind_runtime::decode_path(path) else {
        return error_result(&crate::bind_runtime::AppError::BadRequest(::std::string::String::from("malformed request path")));
    };
    match crate::bind_runtime::rpc_route(&path) {
        "/api/largo" => {
            let (input, ctx) = match begin::<LargoInput>(body, pool).await {
                ::std::result::Result::Ok(started) => started,
                ::std::result::Result::Err(response) => return response,
            };
            let result = app::bind_largo(ctx.clone(), input.a, input.b, input.c, input.d, input.e, input.f, input.g, input.h, input.x, input.y, input.z).await;
            finish(ctx, result).await
        }
        _ => error_result(&crate::bind_runtime::AppError::NotFound(::std::string::String::from("RPC procedure not found"))),
    }
}

/// `handle_rpc` on a runtime worker thread, whose stack is sized for deep Bind recursion
/// (the thread that drives the HTTP runtime may have a smaller one).
pub async fn serve_rpc(
    path: ::std::string::String,
    body: ::std::vec::Vec<u8>,
    pool: ::sqlx::PgPool,
) -> HttpResult {
    match ::tokio::spawn(async move { handle_rpc(&path, &body, &pool).await }).await {
        ::std::result::Result::Ok(result) => result,
        ::std::result::Result::Err(_) => error_result(&crate::bind_runtime::AppError::Internal(::std::string::String::from("the request task failed"))),
    }
}

#[cfg(test)]
mod tests {
    #[test]
    fn requests_with_unknown_fields_are_rejected() {
        assert!(::serde_json::from_str::<super::LargoInput>("{\"bindUnknownField\":0}").is_err());
    }

    #[test]
    fn unknown_procedures_and_malformed_requests_never_reach_the_database()
    -> ::std::result::Result<(), ::std::boxed::Box<dyn ::std::error::Error>> {
        let runtime = ::tokio::runtime::Builder::new_current_thread().enable_all().build()?;
        runtime.block_on(async {
            let pool = ::sqlx::postgres::PgPoolOptions::new()
            .connect_lazy("postgresql://bind-test.invalid/none")?;
            let missing = super::handle_rpc("/api/bindMissingProcedure", b"{}", &pool).await;
            assert_eq!(missing.status, 404);
            let malformed = super::handle_rpc("/api/largo", b"not json", &pool).await;
            assert_eq!(malformed.status, 400);
            ::std::result::Result::Ok(())
        })
    }
}
